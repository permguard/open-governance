{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengov.permguard.com/specs/0.1/open-compliance-lineage/catalog.schema.json",
  "title": "Open Compliance Lineage catalog 0.1",
  "description": "What a person reads of the laws, standards and events a producer's records cite: names, citations, dates of application, titles, in every language the catalog carries.",
  "type": "object",
  "required": [
    "ocl_catalog",
    "id",
    "version",
    "default_language",
    "laws"
  ],
  "additionalProperties": false,
  "properties": {
    "ocl_catalog": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "default_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "laws": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": {
        "pattern": "^(eu-[a-z0-9-]+|std:[a-z0-9][a-z0-9._-]*|org:[a-z0-9][a-z0-9._-]*|[a-z]{2}:[a-z0-9][a-z0-9._-]*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/law"
      }
    },
    "triggers": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": {
        "pattern": "^[a-z0-9_]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/trigger"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "law": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "applies_from": {
          "$ref": "#/$defs/time"
        },
        "provisions": {
          "type": "object",
          "maxProperties": 20000,
          "propertyNames": {
            "pattern": "^[^.\\s]+(\\.[^.\\s]+){0,2}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/provision"
          }
        }
      }
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "citation": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "applies_from": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
