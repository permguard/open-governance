{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengov.permguard.com/specs/0.1/open-decision-lineage/schema.json",
  "title": "Open Decision Lineage, version 0.1: a record",
  "description": "One ODL span in the logical JSON form of the specification: its resource, its attributes and its status. It holds what the specification requires: the types of every attribute, the values of its enumerations, the bounds of its lists and counts, and the attributes each kind of span must carry. Attributes the specification does not define are allowed, as receivers keep them. Copyright (c) 2022 Nitro Agility S.r.l. SPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "required": ["resource", "attributes"],
  "properties": {
    "resource": { "$ref": "#/$defs/resource" },
    "name": { "type": "string" },
    "context": {
      "type": "object",
      "properties": {
        "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "parent_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
    "status_code": { "enum": ["UNSET", "OK", "ERROR"] },
    "status_message": { "type": "string" },
    "attributes": { "$ref": "#/$defs/attributes" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "texts": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/text" }, "maxItems": 1000 },
    "count": { "type": "integer", "minimum": 0 },
    "resource": {
      "type": "object",
      "description": "The OpenTelemetry resource of the producer: it makes the span ODL, and names the pipeline and its shape.",
      "required": ["odl.version", "odl.pipeline.id", "odl.pipeline.version"],
      "properties": {
        "odl.version": { "const": "0.1", "description": "The version of this specification the spans follow." },
        "odl.pipeline.id": { "$ref": "#/$defs/text", "description": "The pipeline, stable across runs and versions." },
        "odl.pipeline.version": { "$ref": "#/$defs/text", "description": "The pipeline's shape: its steps, their kinds and their order." },
        "odl.pipeline.name": { "type": "string", "description": "The name a person reads." },
        "service.name": { "type": "string", "description": "OpenTelemetry's own: the worker that emitted the spans." }
      }
    },
    "attributes": {
      "type": "object",
      "description": "The span's attributes.",
      "required": ["odl.span.kind", "odl.run.id", "odl.job.id"],
      "properties": {
        "odl.span.kind": { "enum": ["batch", "step", "heartbeat", "run"] },
        "odl.run.id": { "$ref": "#/$defs/text", "description": "The run, a UUIDv7." },
        "odl.job.id": { "$ref": "#/$defs/text", "description": "The job inside the run." },
        "odl.run.state": { "enum": ["running", "succeeded", "failed", "cancelled"] },
        "odl.step.id": { "$ref": "#/$defs/text" },
        "odl.step.name": { "type": "string" },
        "odl.step.kind": { "enum": ["source", "transform", "enrich", "detect", "aggregate", "sink"] },
        "odl.step.upstream": { "$ref": "#/$defs/texts" },
        "odl.input.stream": { "$ref": "#/$defs/text" },
        "odl.input.cursor": { "type": "string" },
        "odl.input.ids": { "$ref": "#/$defs/ids" },
        "odl.input.group_id": { "type": "string" },
        "odl.input.count": { "$ref": "#/$defs/count" },
        "odl.output.stream": { "$ref": "#/$defs/text" },
        "odl.output.ids": { "$ref": "#/$defs/ids" },
        "odl.output.group_id": { "type": "string" },
        "odl.output.count": { "$ref": "#/$defs/count" },
        "ogs.transaction.ids": { "$ref": "#/$defs/ids", "description": "The business transactions the findings written are about: keyed derivations, never the references (Span-Native Governance, Records)." },
        "odl.failed.count": { "$ref": "#/$defs/count" },
        "odl.processed.total": { "$ref": "#/$defs/count" },
        "odl.failed.total": { "$ref": "#/$defs/count" }
      },
      "allOf": [
        {
          "if": { "properties": { "odl.span.kind": { "const": "step" } } },
          "then": { "required": ["odl.step.id", "odl.step.kind"] }
        },
        {
          "if": { "properties": { "odl.span.kind": { "const": "heartbeat" } } },
          "then": { "required": ["odl.run.state"], "properties": { "odl.run.state": { "const": "running" } } }
        },
        {
          "if": { "properties": { "odl.span.kind": { "const": "run" } } },
          "then": {
            "required": ["odl.run.state"],
            "properties": { "odl.run.state": { "enum": ["succeeded", "failed", "cancelled"] } }
          }
        }
      ]
    }
  }
}
